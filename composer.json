{
    "name": "bataille/bataille",
    "description": "Jeu de bataille en PHP",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bataille\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bataille\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}